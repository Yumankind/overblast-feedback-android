# The wrapper (gradlew, gradlew.bat, gradle/wrapper/gradle-wrapper.jar) IS committed, so the build
# runs with `./gradlew` on a fresh clone and on JitPack. What is ignored is what a build writes.
.gradle/
build/
*/build/
*/*/build/
