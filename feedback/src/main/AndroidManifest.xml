<?xml version="1.0" encoding="utf-8"?>
<!--
  THE ONE PERMISSION. The library calls one host, the feedback door, and needs nothing else: no
  storage permission (reports waiting to be resent live in the app's own files directory), no
  identifier (the device id is a random UUID the library keeps in its own preferences), and no
  READ_LOGS (an app may always read its own process's logcat).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
